# tuned/repo.env -- faiss-specific build settings. Sourced by tuned/env.sh after the shared device
# and toolkit definitions (tuned/common-data, from zbrad/tuned-common).
#
# This file may only ADD repo-specific settings. Changing any shared key (the device facts, CUDA_*,
# TOOLKIT_*) is a loud error from env.sh.
#
# Plain assignment on purpose: this file is sourced inside a function, where `declare` would make
# the variable local and lose it.

case "${GPU_TUNED_VARIANT}" in
    gb10)
        GPU_TUNED_BLAS="openblas"
        # BLAS and LAPACK are built from source and linked statically (tuned/openblas_build.sh): no system libopenblas.
        GPU_TUNED_OPENBLAS_TAG="v0.3.34"
        GPU_TUNED_OPENBLAS_SHA="e0166008be8e466242aa76b2ff75ce3f0fbf574a"
        GPU_TUNED_OPENBLAS_TARGET="NEOVERSEV2"
        GPU_TUNED_OPT_LEVEL="generic"
        GPU_TUNED_SWIG_TARGETS="swigfaiss"
        GPU_TUNED_MAKE_TARGETS="faiss faiss_c"
        ;;
    rtx40|rtx50)
        GPU_TUNED_BLAS="mkl"
        GPU_TUNED_MKL_ROOT="/opt/intel/oneapi/mkl/latest"
        GPU_TUNED_OPT_LEVEL="avx2"
        GPU_TUNED_SWIG_TARGETS="swigfaiss swigfaiss_avx2 swigfaiss_avx512"
        GPU_TUNED_MAKE_TARGETS="faiss faiss_avx2 faiss_avx512 faiss_c faiss_c_avx2 faiss_c_avx512"
        ;;
    *) echo "ERROR: repo.env: no faiss settings for variant '${GPU_TUNED_VARIANT}'" >&2; return 1 ;;
esac
